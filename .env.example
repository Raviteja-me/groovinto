# Razorpay (Dashboard -> Account & Settings -> API Keys)
# Use rzp_test_* keys while testing and rzp_live_* keys in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Same key id, exposed to the browser for Razorpay Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay webhook secret (Dashboard -> Settings -> Webhooks). Optional but recommended.
RAZORPAY_WEBHOOK_SECRET=

# Admin panel login (/admin). Defaults are admin / groovinto@123 for testing. Change before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=groovinto@123
# Any long random string, signs the admin session cookie.
ADMIN_SESSION_SECRET=
